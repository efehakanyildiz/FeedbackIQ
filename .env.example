# Gemini API Configuration
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection: gemini-3.7-flash, gemini-3.5-flash, gemini-3.8-flash (Free Tier)
GEMINI_MODEL=gemini-3.7-flash

# DEMO_MODE: When true, enables deterministic mock extraction when API key is missing or offline
DEMO_MODE=false
